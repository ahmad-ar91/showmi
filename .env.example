# Meta Model API credentials. Leave META_API_KEY empty to run with realistic simulated output.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Force simulated responses even when a key is present (handy for demos / UI work).
MOCK_MODE=true

# Model identifiers (override if your Meta API tenant exposes different IDs).
META_SAM_MODEL=sam-3.1
META_SPARK_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0

# ---- Provider selection (meta | google | deepseek | mock) ----
# AI_PROVIDER sets the default for every capability; the three below override per capability.
# A provider that is not configured (missing key) falls back to mock automatically.
AI_PROVIDER=meta
# AI_TEXT_PROVIDER=deepseek
# AI_IMAGE_PROVIDER=google
# AI_SEGMENT_PROVIDER=google

# ---- Google Gemini (text + vision, image generation, UI detection) ----
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_TEXT_MODEL=gemini-2.5-flash
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# ---- DeepSeek (text only; pair with meta/google for image + segmentation) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
