# Meta Model API credentials. Leave META_API_KEY empty to run with realistic simulated output.
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/v1

# Force simulated responses even when a key is present (handy for demos / UI work).
MOCK_MODE=true

# Model identifiers (override if your Meta API tenant exposes different IDs).
META_SAM_MODEL=sam-3.1
META_SPARK_MODEL=muse-spark
META_IMAGE_MODEL=muse-image
